# Copy as /etc/xnet-rms/core.env, mode 0600. Fill every empty value.
DATABASE_URL=
JWT_SECRET=
RMS_PKI_DIR=/etc/xnet-rms/core-pki
RMS_LISTEN=:8443
RMS_PUBLIC_URL=
RMS_CORE_URL=
RMS_MQTT_URL=
RMS_MQTT_HOST=
RMS_TUNNEL_DOMAIN=
RMS_TUNNEL_PORT=9443
RMS_REVOKED_DIR=/var/lib/xnet-rms/revoked
# Deliberately unset until retention measurements are reviewed.
RMS_RAW_DAYS=
RMS_SUMMARY_DAYS=
