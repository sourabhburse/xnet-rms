# Copy as /etc/xnet-rms/core.env, mode 0600. Fill every empty value.
DATABASE_URL=
JWT_SECRET=
RMS_PKI_DIR=/etc/xnet-rms/core-pki
RMS_LISTEN=:8445
RMS_PUBLIC_URL=https://xnet-rms-test.duckdns.org:8445
RMS_CORE_URL=https://xnet-rms-test.duckdns.org:8445
RMS_MQTT_URL=ssl://xnet-rms-test.duckdns.org:8883
RMS_MQTT_HOST=xnet-rms-test.duckdns.org
RMS_TUNNEL_DOMAIN=xnet-rms-test.duckdns.org
RMS_TUNNEL_PORT=9443
RMS_REVOKED_DIR=/var/lib/xnet-rms/revoked
# Raw telemetry must cover the supported 30-day reporting window.
# Set summary retention higher when longer aggregate reports are required.
RMS_RAW_DAYS=
RMS_SUMMARY_DAYS=
