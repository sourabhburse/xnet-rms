[Unit]
Description=XNET RMS core
After=network-online.target xnet-rms-mqtt.service
Wants=network-online.target
[Service]
User=xnet-rms-core
Group=xnet-rms-core
EnvironmentFile=/etc/xnet-rms/core.env
ExecStart=/opt/xnet-rms/xnet-rms -mode core
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xnet-rms/revoked
MemoryMax=1G
CPUQuota=150%
TasksMax=128
LimitNOFILE=32768
UMask=0077
[Install]
WantedBy=multi-user.target
